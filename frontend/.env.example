# Q-Guard frontend (public / browser-safe only)
# Copy to .env.local for local development.

# Go API base URL (no trailing slash). Never put Etherscan/RPC keys here.
NEXT_PUBLIC_QGUARD_API_BASE_URL=http://127.0.0.1:8080

# Educational quantum FastAPI sidecar (no secrets).
NEXT_PUBLIC_QGUARD_QUANTUM_API_BASE_URL=http://127.0.0.1:8090

# Optional: enable UI-only fixtures for offline layout work (never used in production API flows by default).
NEXT_PUBLIC_QGUARD_USE_MOCKS=false
