# Q-Guard local development environment
# Copy to .env and fill in real values. Never commit .env or API keys.

# application
QGUARD_APP_ENV=development
QGUARD_LOG_LEVEL=info

# HTTP server
QGUARD_SERVER_HOST=127.0.0.1
QGUARD_SERVER_PORT=8080
QGUARD_CORS_ORIGINS=http://localhost:3000

# Ethereum Mainnet only (MVP)
QGUARD_ETH_RPC_URL=https://YOUR_ETH_MAINNET_RPC_ENDPOINT
QGUARD_CHAIN_ID=1

# Etherscan API v2
QGUARD_ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
QGUARD_ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
QGUARD_ETHERSCAN_API_VERSION=v2
QGUARD_ETHERSCAN_MAX_PAGES=10
QGUARD_ETHERSCAN_MAX_RETRIES=3
QGUARD_ETHERSCAN_RETRY_BACKOFF=200ms

# Timeouts and history caps
QGUARD_REQUEST_TIMEOUT=15s
QGUARD_SCAN_TIMEOUT=120s
QGUARD_MAX_HISTORY_PAGE_SIZE=100
QGUARD_SCAN_MAX_TXS=500

# Provider client rate limiting
QGUARD_RATE_LIMIT_RPS=4
QGUARD_RATE_LIMIT_BURST=8

# Optional RPC cross-check of indexer block hashes (0 disables)
QGUARD_BLOCK_HASH_CHECK_LIMIT=5

# --- Local integration (Prompt 8) ---
# Frontend (public URLs only; set in frontend/.env.local as NEXT_PUBLIC_*)
# NEXT_PUBLIC_QGUARD_API_BASE_URL=http://127.0.0.1:8080
# NEXT_PUBLIC_QGUARD_QUANTUM_API_BASE_URL=http://127.0.0.1:8090

# Quantum FastAPI sidecar (educational; no chain secrets)
QGUARD_QUANTUM_HOST=127.0.0.1
QGUARD_QUANTUM_PORT=8090
